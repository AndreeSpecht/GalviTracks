# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/
env/

# O .env, o config/motoboys.json, o banco data/radar.db e o tools/ngrok.exe SÃO versionados,
# para que um clone em qualquer PC já funcione com os dados da loja.
# Nunca coloque no .env o authtoken do ngrok nem outras senhas: o repositório é público.

# Arquivos temporários do banco e da execução
data/*
!data/radar.db
*.db-wal
*.db-shm
*.sqlite3
sessao_*.json

# Binários: só o launcher e o ngrok vão para o repositório
*.exe
!/GalviTracks.exe
tools/*
!tools/ngrok.exe

# Arquivos locais do autor / legado
_legado_local/

# IDE / SO
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
~$*

# Node (gerador do cronograma)
node_modules/
package-lock.json
