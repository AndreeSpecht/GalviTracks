# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/
env/

# O .env, o config/motoboys.json e o tools/ngrok.exe SÃO versionados,
# para que um clone em qualquer PC já funcione. O banco (data/radar.db) NÃO: o oficial fica
# no servidor da nuvem (docs/nuvem.md) e tem clientes reais e senhas (com hash).
# Nunca coloque no .env o authtoken do ngrok nem outras senhas: o repositório é público.
# Senhas deste PC ficam no .env.local (criado pelo GalviTracks.exe na primeira vez).
.env.local
.env.nuvem

# Arquivos temporários do banco e da execução
data/*
*.db-wal
*.db-shm
*.sqlite3
sessao_*.json

# Binários: só o launcher e o ngrok vão para o repositório
*.exe
!/GalviTracks.exe
tools/*
!tools/ngrok.exe

# Arquivos locais do autor / legado
_legado_local/*
!_legado_local/oficinas.db

# IDE / SO
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
~$*

# Node (gerador do cronograma)
node_modules/
package-lock.json
