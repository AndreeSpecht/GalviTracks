# Copie para .env.nuvem na pasta do projeto, no servidor (cp deploy/env.nuvem.example .env.nuvem)
# e preencha. O .env.nuvem tem senhas: nunca vai para o Git.

# Domínio do painel (o registro DNS tipo A precisa apontar para o IP do servidor)
DOMINIO=galvitracks.com.br

# Senha dos celulares: a mesma do app OwnTracks (Identificação -> Senha). Obrigatória.
OWNTRACKS_TOKEN=

# Chave que assina o cookie de login. Gere com:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Opcional: as demais opções do .env (alertas, filtro de GPS etc.) podem ser repetidas aqui.
