# Proxy reverso com HTTPS automático (Let's Encrypt) para o domínio do .env.nuvem.
# O Caddy acrescenta o X-Forwarded-For com o IP real do cliente; o GalviTracks confia
# nele porque a conexão vem da rede interna do Docker (PROXIES_CONFIAVEIS).
{$DOMINIO} {
	# Tempo real (SSE): repassa cada evento na hora, sem compressão nem buffer
	handle /api/stream {
		reverse_proxy app:5000 {
			flush_interval -1
		}
	}

	handle {
		encode zstd gzip
		reverse_proxy app:5000
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		-Server
	}
}
