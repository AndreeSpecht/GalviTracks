# Copie para .env e ajuste conforme a loja. Todas as variáveis são opcionais.

# Identidade e localização da loja (ponto de saída/retorno das rotas)
NOME_EMPRESA=Radar Auto Peças
BASE_LAT=-26.508484936938192
BASE_LON=-49.10542231274289
CIDADE_BUSCA=Jaraguá do Sul, SC

# Servidor
HOST=0.0.0.0
PORT=5000
THREADS=24
# Máximo de SSE simultâneos; mantenha pelo menos 4 threads livres para a API.
STREAM_MAX=10

# Roteirização (OSRM público por padrão; pode apontar para um servidor próprio)
OSRM_URL=https://router.project-osrm.org
NOMINATIM_URL=https://nominatim.openstreetmap.org
FATOR_ATRASO=1.6
VELOCIDADE_MEDIA_OFFLINE_KMH=25
MINUTOS_POR_PARADA=5

# Rastreamento GPS (OwnTracks)
# Senha do endpoint /api/gps/owntracks (a mesma do app OwnTracks).
# Obrigatória para receber posições pela internet: sem ela o túnel não abre.
OWNTRACKS_TOKEN=
GPS_PRECISAO_MAX_M=100
GPS_VELOCIDADE_MAX_KMH=150
# Peso da leitura nova na velocidade exibida (0–1); trilha mantém o valor bruto.
GPS_VELOCIDADE_ALPHA=0.35
SESSAO_INTERVALO_S=5
TRACKLOG_DIAS=90

# Alertas do painel (semana 9)
ALERTA_SEM_SINAL_MIN=3       # minutos sem mensagem do celular durante a entrega
ALERTA_PARADO_MIN=10         # minutos parado fora de cliente durante a entrega
ALERTA_RAIO_PARADO_M=50      # deslocamento mínimo para considerar que andou
ALERTA_RAIO_CLIENTE_M=100    # distância até um cliente/parada que conta como "no cliente"
ALERTA_BATERIA_MIN=20        # % da bateria do celular

# Acesso externo pelo túnel ngrok (aberto pelo GalviTracks.exe ou scripts/windows/tunel_ngrok.bat).
# Pelo túnel só os celulares entram; o painel fica restrito à rede da loja.
NGROK_DOMAIN=

# Caminhos de dados (padrão: pasta data/)
# DB_PATH=data/radar.db
# ARQUIVO_SESSAO=data/sessao.json
